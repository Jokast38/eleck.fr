# ─────────────────────────────────────────────────────────────
# elec k : variables d'environnement
# Copier ce fichier en « .env » et compléter. Ne jamais committer .env.
# Aucune variable NEXT_PUBLIC_ ne doit contenir de secret.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Neon, Supabase, Vercel Postgres… ou `npm run db:dev` en local)
DATABASE_URL="postgresql://eleck:eleck@localhost:5433/eleck"

# Auth.js : générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
# URL publique (utilisée par Auth.js derrière un proxy)
AUTH_URL="http://localhost:3000"
# Exiger la double authentification (TOTP) pour tous les comptes : true/false
REQUIRE_2FA="false"

# Compte administrateur créé par le seed (`npm run db:seed`)
SEED_ADMIN_EMAIL="contact@eleck.fr"
SEED_ADMIN_NAME="Khaled KACED"
SEED_ADMIN_PASSWORD=""

# SMTP : envoi (boîte pro du domaine)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@eleck.fr"
SMTP_PASS=""

# IMAP : lecture de la boîte dans le dashboard
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="contact@eleck.fr"
IMAP_PASS=""
# Nombre de jours d'historique importés lors de la première synchronisation
IMAP_INITIAL_DAYS="90"
# true sur un serveur permanent (VPS/Docker) : écoute IMAP IDLE en continu, même dashboard fermé
MAIL_IDLE_ALWAYS="false"

MAIL_FROM="elec k <contact@eleck.fr>"
MAIL_NOTIFY_TO="contact@eleck.fr"

# Cloudflare Turnstile (anti-spam). Clés de test Cloudflare : site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (limitation de débit). Vide = limitation en mémoire (dev uniquement)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Secret des tâches planifiées (Vercel Cron → /api/cron/mail-sync)
CRON_SECRET=""

NEXT_PUBLIC_SITE_URL="https://www.eleck.fr"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="eleck.fr"
# Lien public vers la fiche Google (section avis)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=""
